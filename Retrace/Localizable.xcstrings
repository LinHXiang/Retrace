    "accessibility_alert_comment": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح حق الوصول إلى هذا التطبيق في {الجزء}، الموجود في {الإعدادات}.\n\nانقر على الزر +، وحدد Retrace ثم قم بالتبديل على مربع الاختيار المجاور له."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дазвольце доступ гэтаму дадатку ў наладах {pane} у {settings}.\n\nНацісніце кнопку «+», абярыце «Retrace» і ўсталюйце сцяжок побач з ім."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "{settings}-এ অবস্থিত {pane}-এ এই অ্যাপ্লিকেশনটিতে অ্যাক্সেস মঞ্জুর করুন৷\n\n+ বোতামে ক্লিক করুন, Retrace নির্বাচন করুন এবং এর পাশের চেকবক্সে টগল করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobrite pristup ovoj aplikaciji u postavkama {pane}, koje se nalaze u {settings}.\n\nKliknite na dugme +, izaberite Retrace i potvrdite izbor u polju za potvrdu pored njega."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dóna accés a aquesta aplicació al {panell}, dins els {ajustaments}.\n\nFes clic al botó +, selecciona Retrace, i confirma la casella de selecció al costat d'aquest."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دەستڕاگەیشتن بدە بەم ئەپلیکەیشنە لە {pane}، کە لە {settings} دایە.\n\nکلیک لەسەر دوگمەی +، Retrace هەڵبژێرە، و سندوقچەکەی تەنیشتی چالاک بکە."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uděl aplikaci přístup v {pane}, umístěném v {settings}.\n\nKlikni na tlačítko +, vyber Retrace a zapni přepínač vedle názvu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff für diese Anwendung in “{settings} > {pane} > Datenschutz > Bedienungshilfen”.\n\nKlicken Sie auf die Schaltfläche “+“, wählen Sie “Retrace“ aus und aktivieren Sie das Kontrollkästchen daneben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώσε πρόσβαση σε αυτήν την εφαρμογή στο {pane}, που βρίσκεται στις {settings}\n\nΠάτα το κουμπί +, επίλεξε Retrace, και ενεργοποίησε το κουτάκι δίπλα του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant access to Retrace in {pane}, located in {settings}.\n\nClick + button, select Retrace, and toggle on the checkbox next to it."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Donu aliron al la aplikaĵo en {pane}, trovebla en {settings}.\n\nAlklaku la butonon +, elektu Retrace, kaj ŝaltu la elektobutonon apud ĝi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otorgar acceso a esta aplicación en {panel}, ubicado en {settings}.\n\nHaga clic en el botón +, seleccionar Retrace y activar la casilla de verificación junto a él."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant access to Retrace in {pane}, located in {settings}.\n\nClick + button, select Retrace, and toggle on the checkbox next to it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accorder les droits à cette application dans le panneau {pane}, situé dans {settings}.\n\nCliquez sur le bouton +, sélectionnez “Retrace“ et cochez la case à côté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הענקת גישה ליישום הזה דרך {pane}, שנמצא תחת {settings}.\n\nלחיצה + כפתור, לבחור ב־Retrace ולהחליף את מצב תיבת הסימון שלידו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस एप्लिकेशन को {pane} में, जो कि {settings} में स्थित है, एक्सेस दें।\n\n+ बटन पर क्लिक करें, मैकी का चयन करें, और उसके बगल में स्थित चेकबॉक्स को सक्रिय करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli pristup ovoj aplikaciji u postavkama {pane} unutar {settings}.\n\nKliknite gumb „+”, odaberite „Retrace” i uključite potvrdni okvir pokraj njega."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj engedélyt az alkalmazásnak a {pane} részben, amely a {settings} beállításoknál található.\n\nKattints a + gombra, válaszd a Retrace-t, majd kapcsold be a mellette lévő jelölőnégyzetet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant access to Retrace in {pane}, located in {settings}.\n\nClick + button, select Retrace, and toggle on the checkbox next to it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi l'accesso a questa applicazione nella sezione {pane}, situata in {settings}.\n\nFai clic sul pulsante “+“, seleziona “Retrace“ e attiva la casella di controllo accanto ad esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{settings}{pane}環境設定で、このアプリケーションへのアクセスを許可してください。\n\n“+“ボタンをクリックし、“Retrace“を選択して、その横のチェックボックスをオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{settings} 있는 {pane} 정보 보호 환경설정에서 이 응용 프로그램에 접근 권한을 부여하십시오.\n\n“+“ 버튼을 클릭하고 “Retrace“를 선택한 다음 옆에 있는 확인란을 토글합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suteikite prieigą šiai programai {pane}, esančiai {settings}.\n\nSpustelėjimas + mygtukas, pasirinkite Retrace ir pažymėkite šalia esantį žymimąjį langelį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piešķirt piekļuvi šai lietotnei izvelnē {pane}, kas atrodas {settings}.\n\nNoklikšķiniet uz + pogas, atlasiet Retrace un ieslēdziet tai blakus esošo izvēles ķeksīti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tillatelse til dette programmet i {pane} innstillingene, lokalisert i {settings}.\n\nKlikk på +-knappen, velg “Retrace“ og velg avmerkingsboksen ved siden av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verleen toegang tot deze app in {pane}, te vinden in {settings}.\n\nKlik op de + knop, selecteer Retrace en schakel het selectievakje ernaast in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj dostęp tej aplikacji w {pane}, w {settings}.\n\nKliknij przycisk +, wybierz Retrace i kliknij przełącznik obok."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acesso a esta aplicação em {pane}, localizado em {settings}.\n\nClique o botão +, selecione Retrace e ative a caixa de seleção próxima dele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acesso a este aplicativo em {pane}, localizado em {settings}.\n\nClique + botão, selecione Retrace e ative a caixa de seleção próxima a ele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acordă acces acestei aplicații în {pane}, aflat în {settings}.\n\nFă clic pe butonul +, selectează Retrace și bifează caseta de selectare de lânga aceasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставьте права доступа этой программе в настройках {pane} в {settings}.\n\nНажмите кнопку «+», выберите «Retrace» и установите флажок рядом с ним."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobrite dostop do te aplikacije v {pane}, ki se nahaja v {settings}.\n\nKliknite gumb +, izberite Retrace in vklopite potrditveno polje poleg njega."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant access to Retrace in {pane}, located in {settings}.\n\nClick + button, select Retrace, and toggle on the checkbox next to it."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பயன்பாட்டிற்கான அணுகலை {pane} இல், {அமைப்புகள் in இல் அமைந்துள்ளது.\n\n + பொத்தானைக் சொடுக்கு செய்து, மேக்சியைத் தேர்ந்தெடுத்து, அதற்கு அடுத்த தேர்வுப்பெட்டியில் மாற்றவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้สิทธิ์แอปพลิเคชันนี้ในเมนูการตั้งค่า{pane} ใน {settings}.\n\nคลิกปุ่ม ”+” เลือก ”Retrace” และสลับช่องทำเครื่องหมายถัดจากนั้น."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamaya, {settings} {pane} bölümünden izin verin.\n\n“+“ düğmesine tıklayın, Retrace'yi seçin ve yanındaki onay kutusunu işaretleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте доступ до цієї програми в налаштуваннях {pane}, розташованих у {settings}.\n\nНатисніть кнопку “+“, виберіть “Retrace“ і встановіть прапорець поруч із ним."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "{settings} boʻlimida joylashgan {pane} ilovasiga kirishga ruxsat bering.\n\nRetrace-ni tanlang va yonidagi katakchani yoqing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấp quyền truy cập vào ứng dụng này trong {pane}, nằm trong {settings}.\n\nNhấn nút +, chọn Retrace, và bật tùy chọn hộp kiểm bên cạnh nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在{settings}中的{pane}设置中授予 Retrace 权限。\n\n单击“+”按钮，选择“Retrace”并打开旁边的复选框。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在{settings}中的{pane}頁面中授權此應用程式。\n\n按下 + 按鈕，選擇 Retrace 並勾選旁邊的核取方塊。"
          }
        }
      }
    },
