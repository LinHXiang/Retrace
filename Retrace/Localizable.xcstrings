    "accessibility_alert_message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "“\"Retrace\" يرغب في التحكم في هذا الكمبيوتر باستخدام ميزات إمكانية الوصول."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«Retrace» хацеў бы кіраваць гэтым кампутарам ужываючы функцыі магчымасці доступу."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Retrace\" অ্যাক্সেসিবিলিটি বৈশিষ্ট্যগুলি ব্যবহার করে এই কম্পিউটারটিকে নিয়ন্ত্রণ করতে চায়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” želi da kontroliše ovaj računar koristeći funkcije pristupačnosti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” demana accés per controlar aquest ordinador mitjançant les funcionalitats d'accessibilitat."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” دەیەوێت کۆنترۆڵی ئەم کۆمپیوتەرە بکات بە بەکارهێنانی تایبەتمەندییە دەستڕاگەیشتنەکان."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Retrace” by ráda ovládala tento počítač přes fuknce Zpřístupnění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” möchte diesen Computer mittels Bedienungshilfen steuern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το “Retrace” θέλει να ελέγξει αυτόν τον υπολογιστή χρησιμοποιώντας χαρακτηριστικά προσβασιμότητας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” would like to control this computer using accessibility features."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” volas regi la komputilon per alireblecaj funkcioj."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” requiere controlar esta computadora mediante las funciones de accesibilidad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” would like to control this computer using accessibility features."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” souhaite contrôler cet ordinateur en utilisant des fonctions d'accessibilité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "„Retrace” רוצה להשתלט על המחשב הזה דרך יכולות הנגישות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“मैकी” इस कंप्यूटर को एक्सेसिबिलिटी फ़ीचर्स का उपयोग करके नियंत्रित करना चाहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Retrace” želi upravljati ovim računalom koristeći funkcije pristupačnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A “Retrace” irányítani szeretné ezt a számítógépet akadálymentesítési funkciók használatával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” would like to control this computer using accessibility features."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” vorrebbe controllare questo computer utilizzando le funzionalità di accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace”は、アクセシビリティ機能を使用してこのコンピュータを制御することを求めています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace”가 손쉬운 사용 기능을 사용하여 이 컴퓨터를 제어하려고 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Retrace“ norėtų valdyti šį kompiuterį naudodamasis prieinamumo funkcijomis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” vēlas kontrolēt šo datoru, izmantojot pieejamības līdzekļus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” vil ha adgang til denne datamaskinen for tjenester tilknyttet tilgjengelighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” wil deze computer bedienen met toegankelijkheidsfuncties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” chce kontrolować Twój komputer używając funkcji dostępności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” gostaria de controlar este computador usando as funções de acessibilidade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” gostaria de controlar este computador usando as funções de acessibilidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” dorește să controleze acest calculator utilizând funcțiile de accesibilitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «Retrace» запрашивает разрешение на управление компьютером с помощью функций универсального доступа."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” želi ta računalnik nadzorovati s funkcijami dostopnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” would like to control this computer using accessibility features."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அணுகல் அம்சங்களைப் பயன்படுத்தி இந்த கணினியைக் கட்டுப்படுத்த “மேக்சி” விரும்புகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” ต้องการใช้สิทธิ์ฟีเจอร์การช่วยการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace”, erişilebilirlik özelliklerini kullanarak bu bilgisayarı denetlemek istiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” хоче керувати цим комп’ютером за допомогою функцій доступності."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace” ushbu kompyuterni maxsus imkoniyatlardan foydalangan holda boshqarishni xohlaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Retrace\" muốn điều khiển máy tính này bằng các tính năng trợ năng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“Retrace”想要使用“辅助功能”控制此计算机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「Retrace「想要使用「輔助功能」控制此 Mac。"
          }
        }
      }
    },
