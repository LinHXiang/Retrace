    "delete_retrace_history_comment": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht nur:\n%@\n\nDeine Datei ~/.zsh_history wird nicht geändert. Der zsh-Hook erstellt die Retrace-Datei neu, sobald ein neuer Befehl aufgezeichnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes only:\n%@\n\nYour ~/.zsh_history file is not changed. The zsh hook will recreate the Retrace file when a new command is recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo elimina:\n%@\n\nTu archivo ~/.zsh_history no se modifica. El hook de zsh volverá a crear el archivo de Retrace cuando se registre un nuevo comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime uniquement :\n%@\n\nVotre fichier ~/.zsh_history n’est pas modifié. Le hook zsh recréera le fichier Retrace lorsqu’une nouvelle commande sera enregistrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されるのは次のみです:\n%@\n\n~/.zsh_history ファイルは変更されません。新しいコマンドが記録されると、zsh フックが Retrace ファイルを再作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 항목만 삭제합니다:\n%@\n\n~/.zsh_history 파일은 변경되지 않습니다. 새 명령이 기록되면 zsh 훅이 Retrace 파일을 다시 만듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui apenas:\n%@\n\nSeu arquivo ~/.zsh_history não é alterado. O hook do zsh recriará o arquivo do Retrace quando um novo comando for registrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会删除：\n%@\n\n不会修改 ~/.zsh_history。zsh hook 会在记录新命令时重新创建 Retrace 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會刪除：\n%@\n\n不會修改 ~/.zsh_history。zsh hook 會在記錄新命令時重新建立 Retrace 檔案。"
          }
        }
      }
    },
