    "install_zsh_integration_comment": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace fügt ~/.zshrc einen kleinen markierten Hook hinzu.\n\nDer Hook schreibt Befehle hierhin:\n%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace will update ~/.zshrc with a small marked hook.\n\nThe hook appends commands to:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace actualizará ~/.zshrc con un pequeño hook marcado.\n\nEl hook añade comandos a:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace mettra à jour ~/.zshrc avec un petit hook balisé.\n\nLe hook ajoute les commandes à :\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace は ~/.zshrc に小さなマーク付きフックを追加します。\n\nこのフックはコマンドを次に追記します:\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace가 ~/.zshrc에 표시된 작은 훅을 추가합니다.\n\n이 훅은 명령을 다음 위치에 추가합니다:\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Retrace atualizará ~/.zshrc com um pequeno hook marcado.\n\nO hook acrescenta comandos em:\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace 会向 ~/.zshrc 写入一段带标记的轻量 hook。\n\n这个 hook 会把命令追加到：\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace 會向 ~/.zshrc 寫入一段帶標記的輕量 hook。\n\n這個 hook 會把命令追加到：\n%@"
          }
        }
      }
    },
