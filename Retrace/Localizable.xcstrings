    "clear_retrace_history_comment": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies leert nur:\n%@\n\nDeine Datei ~/.zsh_history wird nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears only:\n%@\n\nYour ~/.zsh_history file is not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo borra:\n%@\n\nTu archivo ~/.zsh_history no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface uniquement :\n%@\n\nVotre fichier ~/.zsh_history n’est pas modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去されるのは次のみです:\n%@\n\n~/.zsh_history ファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 항목만 지웁니다:\n%@\n\n~/.zsh_history 파일은 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso limpa apenas:\n%@\n\nSeu arquivo ~/.zsh_history não é alterado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会清空：\n%@\n\n不会修改 ~/.zsh_history。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會清空：\n%@\n\n不會修改 ~/.zsh_history。"
          }
        }
      }
    },
