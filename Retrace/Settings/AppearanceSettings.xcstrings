    "HighlightMatchesTooltip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the highlighting style for search matches.\nDefault: Bold."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改搜索匹配项的突出显示样式。\n默认：粗体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更搜尋符合項目的凸顯樣式。\n預設：粗體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索一致の強調表示スタイルを変更します。\nデフォルト: 太字。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 일치 항목의 강조 스타일을 변경합니다.\n기본값: 굵게."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern Sie den Hervorhebungsstil für Suchtreffer.\nStandard: Fett."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
