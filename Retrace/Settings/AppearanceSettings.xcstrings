    "PopupAtTooltip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change where the command window appears.\nDefault: Cursor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改命令窗口显示的位置。\n默认：光标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改彈窗顯示位置。\n預設：指標。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップアップが表れる場所を変更します。\nデフォルト：カーソル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팝업이 나타나는 위치를 변경합니다.\n기본값: 커서."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere die Position des Popup-Fensters.\nStandard: Mauszeiger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer la localisation de l’apparition du popup.\nPar défaut : Curseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la ubicación donde aparece la ventana emergente\nPor defecto: Cursor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere o local onde o pop-up aparece.\nPadrão: Cursor."
          }
        }
      }
    },
