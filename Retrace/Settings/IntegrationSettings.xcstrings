    "ZshIntegrationExplanationFile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle werden in ~/Library/Application Support/Retrace/zsh_history geschrieben; ~/.zsh_history wird nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commands are written to ~/Library/Application Support/Retrace/zsh_history; ~/.zsh_history is not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comandos se escriben en ~/Library/Application Support/Retrace/zsh_history; ~/.zsh_history no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes sont écrites dans ~/Library/Application Support/Retrace/zsh_history; ~/.zsh_history n’est pas modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドは ~/Library/Application Support/Retrace/zsh_history に書き込まれ、~/.zsh_history は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령은 ~/Library/Application Support/Retrace/zsh_history에 기록되며 ~/.zsh_history는 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comandos são gravados em ~/Library/Application Support/Retrace/zsh_history; ~/.zsh_history não é alterado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令会写入 ~/Library/Application Support/Retrace/zsh_history，不会修改 ~/.zsh_history。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "命令會寫入 ~/Library/Application Support/Retrace/zsh_history，不會修改 ~/.zsh_history。"
          }
        }
      }
    },
    "ZshIntegrationExplanationHook": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace fügt ~/.zshrc einen kleinen markierten Hook hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace adds a small marked hook to ~/.zshrc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace añade un pequeño hook marcado a ~/.zshrc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace ajoute un petit hook balisé dans ~/.zshrc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace は ~/.zshrc に小さなマーク付きフックを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace는 ~/.zshrc에 표시된 작은 훅을 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Retrace adiciona um pequeno hook marcado ao ~/.zshrc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace 会在 ~/.zshrc 添加一段带标记的轻量 hook。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrace 會在 ~/.zshrc 加入一段帶標記的輕量 hook。"
          }
        }
      }
    },
    "ZshIntegrationExplanationTiming": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hook läuft vor jedem zsh-Befehl und zeichnet den Befehl auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hook runs before each zsh command and records the command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hook se ejecuta antes de cada comando de zsh y registra el comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le hook s’exécute avant chaque commande zsh et enregistre la commande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフックは各 zsh コマンドの前に実行され、コマンドを記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 훅은 각 zsh 명령 전에 실행되어 명령을 기록합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O hook roda antes de cada comando zsh e registra o comando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hook 会在每条 zsh 命令执行前运行，并记录这条命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "hook 會在每條 zsh 命令執行前執行，並記錄這條命令。"
          }
        }
      }
    },
