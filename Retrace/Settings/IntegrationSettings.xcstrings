    "ZshIntegrationPrompt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Installation der zsh-Integration zeichnet Retrace Terminalbefehle sofort in Echtzeit auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After installing zsh integration, Retrace immediately records terminal commands in real time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de instalar la integración de zsh, Retrace registra de inmediato los comandos del terminal en tiempo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’installation de l’intégration zsh, Retrace enregistre immédiatement les commandes du terminal en temps réel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "zsh 連携をインストールすると、Retrace はターミナルコマンドをすぐにリアルタイムで記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "zsh 통합을 설치하면 Retrace가 터미널 명령을 즉시 실시간으로 기록합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de instalar a integração do zsh, o Retrace registra imediatamente os comandos do Terminal em tempo real."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 zsh 集成后，Retrace 马上实时记录终端命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝 zsh 整合後，Retrace 會馬上即時記錄終端命令。"
          }
        }
      }
    }
  },
  "version": "1.0"
